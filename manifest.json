{
  "manifest_version": 3,
  "name": "Response Collector",
  "version": "0.1.0",
  "description": "Collect labeled Qwen assistant responses with a small amount of conversation context.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "src/storage.js",
        "src/content/adapters/qwen.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/collector.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Response Collector",
    "default_popup": "src/popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "response-collector@example.local",
      "strict_min_version": "109.0"
    }
  }
}

